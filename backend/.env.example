# Banco de dados
DATABASE_URL="postgresql://jl3d:jl3d_secret@localhost:5432/jl3d_studio"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="troque-por-uma-string-secreta-forte-aqui"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-por-outra-string-secreta-forte"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Upload de arquivos
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app"
EMAIL_FROM="JL3D Studio <seu-email@gmail.com>"

# Preço padrão do kWh (R$/kWh) - configurável nas settings do sistema
DEFAULT_KWH_PRICE=0.75
