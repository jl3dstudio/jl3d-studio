# Banco de dados — use Supabase (recomendado) ou Neon
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# JWT
JWT_SECRET="string-secreta-forte-minimo-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="outra-string-secreta-forte-minimo-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Upload de arquivos
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="JL3D Studio <noreply@jl3d.com>"
