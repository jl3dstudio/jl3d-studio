DATABASE_URL=          # Connection string do Supabase (obrigatório)
JWT_SECRET=            # String aleatória forte (min 32 chars)
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=    # Outra string aleatória forte
JWT_REFRESH_EXPIRES_IN=7d
PORT=3001
NODE_ENV=production
FRONTEND_URL=          # URL da Vercel (ex: https://jl3d-studio.vercel.app)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=JL3D Studio <seu-email@gmail.com>
